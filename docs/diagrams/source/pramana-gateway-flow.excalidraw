      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Permutation test + effect size  (pramana.verification.stats)\n10,000 permutations, two-sided, seeded -> raw p\ncorrelation -> Spearman rho     trend -> Kendall tau-b\n2 groups -> Cliff's delta     3+ groups -> epsilon^2",
      "originalText": "Permutation test + effect size  (pramana.verification.stats)\n10,000 permutations, two-sided, seeded -> raw p\ncorrelation -> Spearman rho     trend -> Kendall tau-b\n2 groups -> Cliff's delta     3+ groups -> epsilon^2",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 61.1,
      "containerId": "btlivbl5yceg7o21",
      "lineHeight": 1.25
    },
