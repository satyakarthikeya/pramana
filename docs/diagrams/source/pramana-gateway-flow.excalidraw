      "updated": 1,
      "link": null,
      "locked": false,
      "text": "HARD GATE  (checks in this order)\n1. q < alpha              else INCONCLUSIVE\n2. |effect| >= metric floor  else NEGLIGIBLE\n3. direction matches claim   else REFUTED\nall three hold  ->  SUPPORTED",
      "originalText": "HARD GATE  (checks in this order)\n1. q < alpha              else INCONCLUSIVE\n2. |effect| >= metric floor  else NEGLIGIBLE\n3. direction matches claim   else REFUTED\nall three hold  ->  SUPPORTED",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
