# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Verification LLM: DeepSeek V4 (gateway ONLY) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Local Gemma (routine sub-agent tasks) ---
GEMMA_BASE_URL=http://localhost:11434
GEMMA_MODEL=gemma2

# --- Langfuse tracing ---
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Infrastructure ---
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8000

# --- App ---
PRAMANA_ENV=dev
PRAMANA_LOG_LEVEL=INFO
