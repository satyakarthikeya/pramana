# DeepSeek-only live profile. Copy to .env and fill keys locally.
# .env is gitignored — never commit real keys.

# No automatic offline/model fallback. Both LLM roles use the same provider/key.
# The project default generator is `template` (configs/verification.yaml, AGENTS.md section 2):
# a vetted test per claim type. The line below opts in to `llm`, where DeepSeek writes each
# test; change it to `template` for the default.
PRAMANA_VERIFICATION_GENERATOR=llm
PRAMANA_API_VERIFICATION_MODE=inprocess
# Who proposes claims: deterministic (no model) | api (summaries only) | agent (tools + workspace).
PRAMANA_ANALYSIS_ENGINE=api
# Close sign-up after the first accounts exist (set to 0). Set PRAMANA_COOKIE_SECURE=1 behind HTTPS.
PRAMANA_ALLOW_SIGNUP=1
PRAMANA_LANGFUSE_ENABLED=true

# --- DeepSeek: structured proposal + falsification code (not statistical verdicts) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- Langfuse tracing ---
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Infrastructure ---
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8000

# --- App ---
PRAMANA_ENV=dev
PRAMANA_LOG_LEVEL=INFO
